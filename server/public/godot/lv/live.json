,2,9999,-1,2,16022008],"2003175":["Rương Vàng Mừng 1/5","Rương vàng mừng ngày 1/5. Mở ra có cơ hội nhận [Trứng Dương Tiễn] và các phần thưởng khác.","gift_51goldbox",4,27,2,9999,-1,2,16022009],"2004004":["1000 Bạc","Chứa 1000 Bạc, mở nhận.","yinbi1000",0,20,2,9999,-1,2,0],"2004070":["Kẹo Giáng Sinh","Kẹo của Ông Già Noel, tiền của sự kiện Giáng Sinh. Kiếm từ trận đấu (thắng 3, thua 1, tối đa 30/ngày) và Lịch Mùa Vọng; dùng treo Quả Châu, gửi quà vào Tất, bù ô lịch và đổi quà ở Xưởng Quà. Kẹo còn lại hết tác dụng sau 05/01.","",2,26,3,9999,-1,2,0],"2004138":["Hoa Điểm 10","Bông hoa điểm 10 mừng Ngày Nhà giáo Việt Nam 20/11. Nhận khi đánh trận, giải Đố Vui, đạt mốc nạp và mốc tiêu xu; dâng tặng Thầy hoặc đổi quà ở Tiệm Văn Phòng Phẩm.","",3,26,3,9999,-1,2,0],"2004169":["Bí Ngô","Tiền tệ sự kiện Đêm Bí Ngô. Nhận từ mốc nạp, mốc tiêu xu và săn trong trận; đổi quà ở Tiệm Phù Thủy.","",4,26,3,9999,-1,2,0],"2004352":["Bánh bao","Dùng xong sẽ ngẫu nhiên nhận một trong các vật phẩm sau:#ENTER#Bóng Thần Bí x 3#ENTER#Thạch Anh Mặt Trời x 1#ENTER#Mảnh Sắt x 100#ENTER#Hồng Bảo x 50#ENTER#Pháo hoa x 5#ENTER#Pháo hoa mừng x 1#ENTER#Sao đầy trời x 1#ENTER#Trứng Transformer x 1#ENTER#Transformer x 1","",4,27,2,9999,-1,2,16010174],"2004526":["Gói Quà Siêu Ưu Đãi Transformer","Quà Tank Transformer lv3, với nguyên liệu tăng lv 3, nhấp đúp mở","gift_dahuangfeng",4,20,2,9999,-1,2,0],"2004602":["Rương Viễn Chinh Vàng","Chiến lợi phẩm hiếm từ Viễn chinh 3 sao: giáp, đá quý cấp cao và Hợp kim thiên thạch, nhấp đúp mở","gift_pvp2",5,20,2,9999,-1,2,0],"2004603":["Rương Viễn Chinh Đồng","Chiến lợi phẩm tank mang về từ Viễn chinh 2 sao: giáp và đá quý cường hóa tank, nhấp đúp mở","gift_shenmiqiu02",3,20,2,9999,-1,2,0],"2004604":["Rương Viễn Chinh Bạc","Chiến lợi phẩm quý từ ô thứ 6 của Viễn chinh 2 sao: giáp và đá quý cường hóa tank cấp cao, nhấp đúp mở","gift_shenmiqiu03",4,20,2,9999,-1,2,0],"2009023":["Trứng trợ thủ Golden Dog","Trứng may mắn chứa nhiều loại nguyên liệu Trợ Thủ: chip siêu dẫn